# === DISCORD ===
DISCORD_TOKEN=your_discord_bot_token_here

# === API GEMPA ===
# USGS: gratis, tidak perlu key
# BMKG: gratis, tidak perlu key

# === MAPBOX (untuk generate peta) ===
# Daftar gratis di https://account.mapbox.com/
MAPBOX_TOKEN=your_mapbox_token_here

# === KONFIGURASI BOT ===
CHECK_INTERVAL_MINUTES=2
DEFAULT_MIN_MAGNITUDE=4.5
DATABASE_PATH=data/bot.db

# === LOGGING ===
LOG_LEVEL=INFO